# ─── Application ────────────────────────────────────────────────────────────
APP_NAME=Astra
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-a-256-bit-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── API ────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=astra
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_secret
DATABASE_URL=postgresql+asyncpg://astra:astra_secret@localhost:5432/astra
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ─── JWT Auth ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-256-bit-secret-for-jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Security ───────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# ─── AI Model Keys (leave empty — injected via Vault in prod) ───────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# ─── External Services ──────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

SENTRY_DSN=
